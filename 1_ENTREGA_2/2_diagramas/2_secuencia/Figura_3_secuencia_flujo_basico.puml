@startuml Figura_3_secuencia_flujo_basico
' Vista dinámica - flujo básico completo del CU 36 (diseño), con las correcciones de la Entrega 1.
' Los mensajes 19-20 se detallan en la Figura 2 (patrón Adapter).
' Los submensajes (7.1, 17.1, 19.1, 22.1, 37.1) son las delegaciones internas de cada entidad.
skinparam dpi 110
skinparam sequenceMessageAlign left
autonumber
title Figura 3 – CU 36 Consultar seguimiento de bolsines: flujo básico (diseño)

actor ":EncargadoDe\nBolsines" as EB
participant ":PantallaConsultar\nSeguimientoBolsines" as P <<boundary>>
participant ":GestorConsultar\nSeguimientoBolsines" as G <<control>>
participant ":Sesion" as SE <<entity>>
participant ":Empleado" as EM <<entity>>
participant ":Usuario" as US <<entity>>
participant ":Rol" as R <<entity>>
participant ":ComisionMedica" as CM <<entity>>
participant ":Bolsin" as B <<entity>>
participant "actual:\nCambioEstadoBolsin" as CE <<entity>>
participant ":Estado" as E <<entity>>
participant ":InterfazGPSTracker" as I <<boundary>>
participant ":UbicacionBolsin" as U
participant ":GestorNotificar\nUbicacionBolsin" as N <<control>>

EB -> P : selecOpcionConsultarUbicacionBolsines()
P -> P : habilitarPantalla()
P -> G : consultarUbicacionBolsines()

G -> G : buscarCM()
loop para cada Sesion
  G -> SE : estaActiva()
end
G -> SE : getUsuario()
loop para cada Empleado
  G -> EM : esTuUsuario(usuario)
  autonumber stop
  EM -> US : 7.1 getNombre()
  autonumber resume
end
G -> EM : getCM()
G -> CM : getCodigo() / getNombre()

G -> G : buscarBolsinesEnviados()
loop para cada Bolsin
  G -> B : esEnviado()
  loop para cada CambioEstadoBolsin
    B -> CE : esActual()
  end
  B -> CE : esEnviado()
  CE -> E : esEnviado()
  E -> E : esAmbitoBolsin()
  G -> B : esTuCMOrigen(cm)
  B -> CM : esMiCM(cm)
  autonumber stop
  CM -> CM : 17.1 getCodigo() (de la CM recibida)
  autonumber resume
end
note right of G : A1: si no hay bolsines enviados, se informa y termina

G -> G : obtenerUbicacionBolsines()
loop para cada bolsín enviado
  G -> B : getNumeroBolsin() / getCodigoCMOrigen() /\ngetCodigoCMDestino() / getModeloGPSTracker()
  autonumber stop
  B -> CM : 19.1 getCodigo() (origen y destino)
  autonumber resume
  G -> I : solicitarUbicacionBolsin(...): UbicacionBolsin
  note right of I : detalle en la Figura 2 (Adapter). A3 si no informa ubicación
end

G -> G : armarMapaDePosicionDeBolsines()
loop para cada bolsín con ubicación
  G -> B : getNumeroBolsin() / getNumeroPrecinto() / getNombreCMOrigen() /\ngetCodigoCMDestino() / getNombreCMDestino() / getModeloGPSTracker()
  autonumber stop
  B -> CM : 22.1 getNombre() (origen) / getCodigo() / getNombre() (destino)
  autonumber resume
  G -> U : getLatitud() / getLongitud() / getFechaHoraUltimaActualizacion()
end
G --> P : MapaBolsinesDTO
P -> P : mostrarMapaDeBolsines()

EB -> P : selecBolsin()
P -> G : tomarSeleccionBolsin(numeroBolsin)
loop para cada bolsín enviado
  G -> B : esTuNumeroBolsin(numeroBolsin)
end
G --> P : BolsinEnMapaDTO
P -> P : solicitarConfirmacionEnvioMail()
EB -> P : confirmarEnvioMail()
note left of P : A5: si no confirma, termina sin enviar
P -> G : tomarConfirmacionDeMail(true)

G -> G : buscarMailDeGerenteCMDestino()
G -> B : getDestino()
loop para cada Empleado
  G -> EM : sosGCMDeCM(cmDestino)
  EM -> R : esGCM()
  EM -> CM : esMiCM(cmDestino)
  autonumber stop
  CM -> CM : 37.1 getCodigo() (de cmDestino)
  autonumber resume
end
G -> EM : getEmail() / getNombreCompleto()
G -> G : llamarCUNotificarUbicacion(mailGerente, nombreGerente)
G -> B : getNumeroBolsin()
G -> U : getFechaHoraUltimaActualizacion() / getLatitud() / getLongitud()
G -> N : notificarUbicacion(mailGerente, nombreGerente, numeroBolsin,\nfechaHora, latitud, longitud)
note right of N : <<include>> CU Notificar ubicación de bolsín
N --> G : MailEnviadoDTO
G -> G : finCU()
G --> P : MailEnviadoDTO
P -> P : mostrarMailEnviado()
@enduml
