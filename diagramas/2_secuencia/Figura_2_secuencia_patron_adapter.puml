@startuml Figura_2_secuencia_patron_adapter
' Vista dinámica - parte del escenario rediseñada por el patrón ADAPTER (pasos 4 y 5 del CU 36)
' Escenario del flujo descripto: GPS Tracker modelo XTR-4500L.
skinparam dpi 120
skinparam sequenceMessageAlign center
autonumber
title Figura 2 – CU 36: obtención de la ubicación de los bolsines con el patrón Adapter (modelo XTR-4500L)

participant ":GestorConsultar\nSeguimientoBolsines" as G <<control>>
participant ":Bolsin" as B <<entity>>
participant "origen:\nComisionMedica" as CMO <<entity>>
participant "destino:\nComisionMedica" as CMD <<entity>>
participant ":InterfazGPSTracker" as I <<boundary>>
participant ":ServicioGPSTracker\nXTR4500L" as S <<adaptee>>
participant ":AdaptadorGPSTracker\nXTR4500L" as A
participant ":UbicacionBolsin" as U

G -> G : obtenerUbicacionBolsines()
loop para cada bolsín enviado
  G -> B : getNumeroBolsin(): int
  G -> B : getCodigoCMOrigen(): String
  B -> CMO : getCodigo(): String
  G -> B : getCodigoCMDestino(): String
  B -> CMD : getCodigo(): String
  G -> B : getModeloGPSTracker(): String
  G -> I : solicitarUbicacionBolsin(numeroBolsin: int, codigoCMOrigen: String,\ncodigoCMDestino: String, modeloGPSTracker: String): UbicacionBolsin
  I -> I : crearAdaptador(modeloGPSTracker: String): IAdaptadorGPSTracker
  create S
  I -> S : new(restClient: RestClient)
  create A
  I -> A : new(claveAPI: String, servicio: ServicioGPSTrackerXTR4500L)
  I -> A : obtenerUbicacion(numeroBolsin: int, codigoCMOrigen: String,\ncodigoCMDestino: String): UbicacionBolsin
  A -> A : solicitarUbicacion(numeroBolsin: int, codigoCMOrigen: String): String
  A -> S : getBolsinLocation(apiKey: String, numeroBolsin: int, codigoCMOrigen: String): String
  S --> A : JSON (String)
  A -> A : adaptarUbicacion(json: String): UbicacionBolsin
  create U
  A -> U : new(numeroBolsin: int, latitud: double, longitud: double,\nfechaHoraUltimaActualizacion: LocalDateTime)
  A --> I : UbicacionBolsin
  I --> G : UbicacionBolsin
end

note over G, I
  A3: si el GPS Tracker no informa la ubicación, el adaptador lanza GPSTrackerException
  y el gestor registra el bolsín como "sin ubicación".
  Los adaptadores NavTrack QX-7A y GeoPulse MTR-900 siguen la misma secuencia.
end note
@enduml
